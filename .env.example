# Local dev only (uvicorn + Vite). Docker always uses backend 9005 + frontend 8083 — see .env.docker.example
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/zydus_takeda
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_KEY=change-me-to-a-long-random-string
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP) — prefer Admin → Settings → Email delivery (stored in DB).
# Env vars below are used when a setting key is not set in the database.
# Leave SMTP_HOST empty to log emails to the API console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ultra Workspace

# SSO (OIDC) — prefer Admin → Settings → Authentication → Single sign-on (DB).
# Env fallback when a setting key is unset. Works with Entra, Okta, Auth0, etc.
# Example Entra: issuer …/{tenant-id}/v2.0, scopes openid profile email
SSO_ENABLED=false
SSO_ISSUER=https://login.microsoftonline.com/88e6707b-c03d-425b-886a-e5736d60b41e/v2.0
SSO_CLIENT_ID=b13c52d0-d836-4e7d-b8d1-01125f0fcd74
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://assets.timadit.com/api/auth/sso/callback
# SSO_BUTTON_LABEL=Sign in with Microsoft
# SSO_SCOPES=openid profile email
# SSO_EMAIL_CLAIM=email
# SSO_SUBJECT_CLAIM=sub
# SSO_ALLOW_JIT=false

# Optional dedicated key for encrypting MFA secrets and SMTP/SSO secrets in the database.
# When unset, the JWT secret is used so existing MFA enrollments keep working.
# DATA_ENCRYPTION_KEY=
# Captcha (only if auth policy captcha is enabled). Leave unset to fail closed.
# CAPTCHA_SECRET=
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# API docs. Unset or true locally. Docker compose sets this false.
# ENABLE_API_DOCS=true

# Technical logs (stdout always; optional daily files in all/ access/ error/ auth/). See docs/LOGGING.md
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_DIR=logs
# LOG_RETENTION_DAYS=30
# Email ERROR log lines to these addresses (comma-separated). Empty = off.
# ERROR_ALERT_EMAILS=
# ERROR_ALERT_THROTTLE_SECONDS=900

# Frontend URL used in password-reset and notification links
FRONTEND_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ENFORCE_SUPERUSER_ON_ADMIN=false
SYNC_MODULES_ON_STARTUP=true
SEED_SYSTEM_EMAIL_TEMPLATES=true

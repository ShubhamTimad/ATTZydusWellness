# Local dev only (uvicorn + Vite). Docker always uses backend 9005 + frontend 8083 — see .env.docker.example
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/zydus_takeda
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_KEY=change-me-to-a-long-random-string
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP) — prefer Admin → Settings → Email delivery (stored in DB).
# Env vars below are used when a setting key is not set in the database.
# Leave SMTP_HOST empty to log emails to the API console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ultra Workspace

# SSO (OIDC) — prefer Admin → Settings → Authentication → Single sign-on (DB).
# Env fallback when a setting key is unset. Works with Entra, Okta, Auth0, etc.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# SSO_BUTTON_LABEL=Sign in with SSO
# SSO_SCOPES=openid profile email
# SSO_EMAIL_CLAIM=email
# SSO_SUBJECT_CLAIM=sub
# SSO_ALLOW_JIT=false

# Technical logs (one stream; filter by request_id / user_id). See docs/LOGGING.md
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=logs/app.log

# Sentry (optional). Leave empty to disable. See docs/SENTRY.md
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=
# SENTRY_SERVER_NAME=localhost
# Temporary: curl "http://localhost:8000/sentry-debug?token=…"
# SENTRY_DEBUG_TOKEN=local-test-token

# Frontend Vite — put the same keys in frontend/.env.local (see frontend/.env.example)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# Frontend URL used in password-reset and notification links
FRONTEND_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ENFORCE_SUPERUSER_ON_ADMIN=false
SYNC_MODULES_ON_STARTUP=true
SEED_SYSTEM_EMAIL_TEMPLATES=true

# Copy to .env.docker and edit before deploy:
#   cp .env.docker.example .env.docker
#
# Always pass --env-file .env.docker to docker compose.

POSTGRES_USER=takeda
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=takeda_att

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Host port mapping: APP_HOST_BIND:APP_PORT -> frontend nginx :80
# VPS / direct browser access (required for http://SERVER_IP:8083 from your PC):
APP_HOST_BIND=0.0.0.0
APP_PORT=8083
# BACKEND_PORT is internal only — do not open 9005 in the firewall for users
BACKEND_PORT=9005
VITE_API_URL=/api

# Public URL users open in the browser (password-reset links, CORS).
# Replace with your server IP or domain — must match how users reach the app.
FRONTEND_ORIGIN=http://YOUR_SERVER_IP:8083
FRONTEND_APP_URL=http://YOUR_SERVER_IP:8083
FRONTEND_ADMIN_URL=http://YOUR_SERVER_IP:8083/admin

# false = RBAC permissions control /admin/* (recommended for workspace users).
# true = only database superusers may call /admin/* APIs.
ENFORCE_SUPERUSER_ON_ADMIN=false
# false = do not auto-insert permissions/features on every backend start (recommended for production).
# Run manually when needed: Admin → Permissions → Sync from config, or scripts/sync_modules.py
SYNC_MODULES_ON_STARTUP=false

# false = do not run ensure_system_email_templates.py on every container start.
# Set true once on first deploy (or configure templates in Admin → Email templates).
SEED_SYSTEM_EMAIL_TEMPLATES=false

# SMTP — required for real forgot-password emails (or configure in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Takeda Workspace

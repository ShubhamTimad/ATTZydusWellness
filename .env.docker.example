POSTGRES_USER=takeda
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=takeda_att

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Safe default on a busy server: keep the app reachable only on the host itself.
# If you do not have an external reverse proxy, change APP_HOST_BIND to 0.0.0.0.
APP_HOST_BIND=127.0.0.1
APP_PORT=8083
VITE_API_URL=/api

# Public URL users open in the browser (used in password-reset and invite links).
# Set to your real domain when behind Nginx/Caddy, e.g. https://assets.example.com
FRONTEND_APP_URL=http://127.0.0.1:8083
FRONTEND_ORIGIN=http://127.0.0.1:8083
FRONTEND_ADMIN_URL=http://127.0.0.1:8083/admin

ENFORCE_SUPERUSER_ON_ADMIN=true
SYNC_MODULES_ON_STARTUP=false

# true = Alembic seeds default templates on first migrate; entrypoint also runs
# scripts/ensure_system_email_templates.py (idempotent) so FORGOT_PASSWORD works.
SEED_SYSTEM_EMAIL_TEMPLATES=true

# SMTP — required for real forgot-password emails (or configure in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Takeda Workspace

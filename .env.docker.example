# Copy to .env.docker and edit before deploy:
#   cp .env.docker.example .env.docker
#
# Always pass --env-file .env.docker to docker compose.

POSTGRES_USER=takeda
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=takeda_att

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Host port mapping: APP_HOST_BIND:APP_PORT -> frontend container :80
# Server behind reverse proxy: 127.0.0.1
# Direct public access or local Docker: 0.0.0.0
APP_HOST_BIND=127.0.0.1
APP_PORT=8083
BACKEND_PORT=9005
VITE_API_URL=/api

# Public URL users open in the browser (password-reset links, CORS).
# Example: https://assets.example.com or http://161.97.93.106:8083
FRONTEND_ORIGIN=http://localhost:8083
FRONTEND_APP_URL=http://localhost:8083
FRONTEND_ADMIN_URL=http://localhost:8083/admin

# false = RBAC permissions control /admin/* (recommended for workspace users).
# true = only database superusers may call /admin/* APIs.
ENFORCE_SUPERUSER_ON_ADMIN=false
SYNC_MODULES_ON_STARTUP=true

# true = Alembic seeds default templates on first migrate; entrypoint also runs
# scripts/ensure_system_email_templates.py (idempotent) so FORGOT_PASSWORD works.
SEED_SYSTEM_EMAIL_TEMPLATES=true

# SMTP — required for real forgot-password emails (or configure in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Takeda Workspace

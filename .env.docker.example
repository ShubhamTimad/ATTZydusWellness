# Copy to .env.docker and edit secrets before deploy:
#   cp .env.docker.example .env.docker
#
# Always pass --env-file .env.docker to docker compose.
# See docs/HTTPS.md and docs/SERVER_DEPLOY.md
#
# Public URL mode (pick ONE):
#   A) HTTP via IP:8083  — active block below (default for now)
#   B) HTTPS via domain  — uncomment the HTTPS block, comment the HTTP FRONTEND_* / bind lines

POSTGRES_USER=takeda
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=takeda_att

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- A) Active now: HTTP via server IP:8083 ---
APP_HOST_BIND=0.0.0.0
APP_PORT=8083
BACKEND_PORT=9005
# Edge proxy host ports (defaults avoid :80 / :8080). App users still use APP_PORT.
PROXY_HTTP_PORT=9080
PROXY_HTTPS_PORT=443
VITE_API_URL=/api
ROOT_PATH=/api

FRONTEND_ORIGIN=http://161.97.93.106:8083
FRONTEND_APP_URL=http://161.97.93.106:8083
FRONTEND_ADMIN_URL=http://161.97.93.106:8083/admin

# --- B) HTTPS / SSL (dev.adityatavnoji.in) — enable when ready ---
# 1) Comment out FRONTEND_* and APP_HOST_BIND in block A above
# 2) Uncomment this block
# 3) docker compose --env-file .env.docker up -d
# 4) ./scripts/ssl-init.sh
# 5) Set Entra + ATT SSO Redirect URI to the SSO_REDIRECT_URI below
#
# DOMAIN=dev.adityatavnoji.in
# CERTBOT_EMAIL=bharat.solanke@timadit.com
# APP_HOST_BIND=127.0.0.1
# FRONTEND_ORIGIN=https://dev.adityatavnoji.in
# FRONTEND_APP_URL=https://dev.adityatavnoji.in
# FRONTEND_ADMIN_URL=https://dev.adityatavnoji.in/admin
# SSO_REDIRECT_URI=https://dev.adityatavnoji.in/api/auth/sso/callback

# Optional: trigger GitHub deploy-develop from Teams. GET /api/deploy-now?token=…
DEPLOY_NOW_TOKEN=
GH_PAT=
GITHUB_REPOSITORY=Timad-Bharat/Asset-Tagging-and-Tracking-Takeda-Web

# false = RBAC permissions control /admin/* (recommended for workspace users).
# true = only database superusers may call /admin/* APIs.
ENFORCE_SUPERUSER_ON_ADMIN=false

# Sync permission/feature catalog from app config on backend start (not demo data).
SYNC_MODULES_ON_STARTUP=true

# Email templates are ensured on every backend container start (idempotent).
SEED_SYSTEM_EMAIL_TEMPLATES=true

# First superuser — created only when no superuser exists in the database.
BOOTSTRAP_SUPERUSER_EMAIL=admin@yourcompany.com
BOOTSTRAP_SUPERUSER_PASSWORD=ChangeMe@123456
BOOTSTRAP_SUPERUSER_FULL_NAME=System Administrator

# SMTP — required for real forgot-password emails (or configure in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Takeda Workspace

# SSO (OIDC) — prefer Admin → Settings → Authentication → Single sign-on.
# Entra requires HTTPS redirect (use block B + this URI). Password login works on HTTP IP.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://dev.adityatavnoji.in/api/auth/sso/callback

# Technical logs — one stream to stdout (docker compose logs). See docs/LOGGING.md
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (optional). Leave DSN empty to disable. See docs/SENTRY.md
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_SERVER_NAME=dev.adityatavnoji.in
# SENTRY_RELEASE=
# SENTRY_DEBUG_TOKEN=

# Browser SDK — baked into frontend image at build. Same DSN as SENTRY_DSN is fine.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Copy to .env.docker and edit secrets before deploy:
#   cp .env.docker.example .env.docker
#
# Always pass --env-file .env.docker to docker compose.
# See docs/HTTPS.md and docs/SERVER_DEPLOY.md
#
# Public URL: https://assets.timadit.com
# TLS terminates on the SERVER'S existing reverse proxy (owns :80/:443).
# That proxy must forward to http://127.0.0.1:8083 — this stack does NOT bind :80.
#
# Set ENABLE_EDGE_PROXY=true only if you want THIS repo's proxy/certbot
# (requires free host ports — not used when another proxy owns 80/443).

POSTGRES_USER=takeda
POSTGRES_PASSWORD=admin
POSTGRES_DB=takeda_att

# --- External database (AWS RDS etc.) instead of the bundled db container ---
# Setting DATABASE_URL makes scripts/docker-*.sh add docker-compose.rds.yml:
# no db container is started and POSTGRES_* above are ignored.
# URL-encode the password: python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=''))" 'p@ss'
# DATABASE_URL=postgresql+psycopg2://APP_USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/DB_NAME?sslmode=require

# --- CI-built images from a registry (client servers: no builds on the server) ---
# Setting IMAGE_REGISTRY makes ./scripts/docker-up.sh pull the images and blocks
# docker-rebuild.sh. Keep the trailing slash. IMAGE_TAG = the VERSION built by CI.
# IMAGE_REGISTRY=registry.example.com/takeda-att/
# IMAGE_TAG=1.0.3

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Active: HTTPS via external proxy → loopback :8083 ---
DOMAIN=assets.timadit.com
ENABLE_EDGE_PROXY=false
APP_HOST_BIND=127.0.0.1
APP_PORT=8083
BACKEND_PORT=9005
VITE_API_URL=/api
ROOT_PATH=/api

FRONTEND_ORIGIN=https://assets.timadit.com
FRONTEND_APP_URL=https://assets.timadit.com
FRONTEND_ADMIN_URL=https://assets.timadit.com/admin
SSO_REDIRECT_URI=https://assets.timadit.com/api/auth/sso/callback

# Optional built-in edge proxy (only when ENABLE_EDGE_PROXY=true)
# CERTBOT_EMAIL=bharat.solanke@timadit.com
# PROXY_HTTP_PORT=18080
# PROXY_HTTPS_PORT=8443

# --- HTTP via server IP:8083 (fallback — set APP_HOST_BIND=0.0.0.0, clear DOMAIN URLs) ---
# APP_HOST_BIND=0.0.0.0
# FRONTEND_ORIGIN=http://161.97.93.106:8083
# FRONTEND_APP_URL=http://161.97.93.106:8083
# FRONTEND_ADMIN_URL=http://161.97.93.106:8083/admin

# false = RBAC permissions control /admin/* (recommended for workspace users).
# true = only database superusers may call /admin/* APIs.
ENFORCE_SUPERUSER_ON_ADMIN=false

# Sync permission/feature catalog from app config on backend start (not demo data).
SYNC_MODULES_ON_STARTUP=true

# Email templates are ensured on every backend container start (idempotent).
SEED_SYSTEM_EMAIL_TEMPLATES=true

# First superuser — created only when no superuser exists in the database.
BOOTSTRAP_SUPERUSER_EMAIL=admin@yourcompany.com
BOOTSTRAP_SUPERUSER_PASSWORD=ChangeMe@123456
BOOTSTRAP_SUPERUSER_FULL_NAME=System Administrator

# SMTP — required for real forgot-password emails (or configure in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Takeda Workspace

# SSO (OIDC) — prefer Admin → Settings → Authentication → Single sign-on.
# Entra (tenant 88e6707b-c03d-425b-886a-e5736d60b41e):
#   Issuer / authority: https://login.microsoftonline.com/88e6707b-c03d-425b-886a-e5736d60b41e/v2.0
#   Client ID: b13c52d0-d836-4e7d-b8d1-01125f0fcd74
#   Redirect URI: https://assets.timadit.com/api/auth/sso/callback
#   Scopes: openid profile email
SSO_ENABLED=false
SSO_ISSUER=https://login.microsoftonline.com/88e6707b-c03d-425b-886a-e5736d60b41e/v2.0
SSO_CLIENT_ID=b13c52d0-d836-4e7d-b8d1-01125f0fcd74
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email

# false hides /docs and /openapi.json. Health check is /health.
ENABLE_API_DOCS=false
UVICORN_WORKERS=2
# DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Technical logs — stdout + daily files (all/ access/ error/ auth/) in a host folder. See docs/LOGGING.md
LOG_LEVEL=INFO
LOG_FORMAT=json
# Folder on the server (outside the container). Default ./logs next to docker-compose.yml.
# LOG_HOST_DIR=/var/log/takeda-att
LOG_RETENTION_DAYS=30

# Email every ERROR log line (unhandled exceptions, failed jobs) to these addresses.
# Comma-separated. Uses the SMTP settings above / Admin → Settings. Empty = off.
# Same error is emailed at most once per ERROR_ALERT_THROTTLE_SECONDS (default 15 min).
ERROR_ALERT_EMAILS=
# ERROR_ALERT_THROTTLE_SECONDS=900
